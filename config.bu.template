variant: fcos
version: 1.5.0

# TRE UTENTI, TRE RUOLI
#   core           amministrazione: SSH con chiave, sudo, deploy. Non fa girare
#                  nessun servizio.
#   homeassistant  solo il container di Home Assistant (rootless).
#   cloudflared    solo il tunnel Cloudflare (rootless).
# Gli utenti di servizio non hanno shell, chiavi SSH ne' sudo: chi uscisse da
# un container si ritroverebbe con un utente che non puo' fare nulla.
# Gli uid sono fissi perche' compaiono nei comandi di servizio (journalctl
# _UID=..., /run/user/<uid>). Gli intervalli subuid/subgid per i container li
# assegna useradd; deploy_app.sh li aggiunge se mancano.
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - "%%SSH_PUB_KEY%%"
      groups:
        - wheel
        - sudo
    - name: homeassistant
      uid: 1001
      home_dir: /var/home/homeassistant
      shell: /usr/sbin/nologin
    - name: cloudflared
      uid: 1002
      home_dir: /var/home/cloudflared
      shell: /usr/sbin/nologin

storage:
  directories:
    # --- homeassistant ---
    - path: /var/home/homeassistant/config
      mode: 0750
      user:
        name: homeassistant
      group:
        name: homeassistant
    - path: /var/home/homeassistant/.config
      mode: 0700
      user:
        name: homeassistant
      group:
        name: homeassistant
    - path: /var/home/homeassistant/.config/containers
      mode: 0700
      user:
        name: homeassistant
      group:
        name: homeassistant
    - path: /var/home/homeassistant/.config/containers/systemd
      mode: 0700
      user:
        name: homeassistant
      group:
        name: homeassistant

    # --- cloudflared ---
    - path: /var/home/cloudflared/.config
      mode: 0700
      user:
        name: cloudflared
      group:
        name: cloudflared
    - path: /var/home/cloudflared/.config/containers
      mode: 0700
      user:
        name: cloudflared
      group:
        name: cloudflared
    - path: /var/home/cloudflared/.config/containers/systemd
      mode: 0700
      user:
        name: cloudflared
      group:
        name: cloudflared
    # Unit utente: timer notturno di podman-auto-update (solo cloudflared).
    - path: /var/home/cloudflared/.config/systemd
      mode: 0700
      user:
        name: cloudflared
      group:
        name: cloudflared
    - path: /var/home/cloudflared/.config/systemd/user
      mode: 0700
      user:
        name: cloudflared
      group:
        name: cloudflared
    - path: /var/home/cloudflared/.config/systemd/user/podman-auto-update.timer.d
      mode: 0700
      user:
        name: cloudflared
      group:
        name: cloudflared
    - path: /var/home/cloudflared/.config/systemd/user/timers.target.wants
      mode: 0700
      user:
        name: cloudflared
      group:
        name: cloudflared

  links:
    # network-online.target attivato al boot ('systemctl add-wants
    # multi-user.target network-online.target'). I servizi rootless lo
    # aspettano tramite podman-user-wait-network-online.service, che pero' non
    # lo richiede: senza questo link nessuno lo attiva e ogni boot perde 90
    # secondi di timeout prima di avviare HA e il tunnel.
    - path: /etc/systemd/system/multi-user.target.wants/network-online.target
      target: /usr/lib/systemd/system/network-online.target

    # Equivale a 'systemctl --user enable podman-auto-update.timer' per
    # cloudflared: systemd.units di Ignition gestisce solo le unit di sistema.
    # Home Assistant non ha il timer: si aggiorna a mano con update_ha.sh.
    - path: /var/home/cloudflared/.config/systemd/user/timers.target.wants/podman-auto-update.timer
      target: /usr/lib/systemd/user/podman-auto-update.timer
      user:
        name: cloudflared
      group:
        name: cloudflared

  files:
    # Linger: le istanze systemd degli utenti di servizio partono al boot,
    # senza login, e con loro i container.
    - path: /var/lib/systemd/linger/homeassistant
      mode: 0644
      contents:
        inline: ""
    - path: /var/lib/systemd/linger/cloudflared
      mode: 0644
      contents:
        inline: ""

    # Permette ai container rootless di usare porte >= 80
    - path: /etc/sysctl.d/99-unprivileged-ports.conf
      mode: 0644
      contents:
        inline: "net.ipv4.ip_unprivileged_port_start=80"

    # Comando per agire come utente di servizio (vedi il commento nel file).
    # /usr/local su FCOS e' un collegamento a /var/usrlocal, l'unica parte
    # scrivibile di /usr.
    - path: /var/usrlocal/bin/svc-run
      mode: 0755
      contents:
        local: services/svc-run

    # --- SEGRETI DI CLOUDFLARED ---
    # Solo cloudflared lo legge, via EnvironmentFile. Placeholder iniziale:
    # push_update.sh lo sostituisce con il token reale.
    - path: /var/home/cloudflared/secrets.env
      mode: 0600
      user:
        name: cloudflared
      group:
        name: cloudflared
      contents:
        inline: |
          TUNNEL_TOKEN=inserisci_qui_il_tuo_token_cloudflare_reale

    # LLMNR spento (vedi il commento nel file).
    - path: /etc/systemd/resolved.conf.d/90-no-llmnr.conf
      mode: 0644
      contents:
        local: services/resolved-no-llmnr.conf

    # Irrobustimento di sshd (vedi il commento nel file).
    - path: /etc/ssh/sshd_config.d/40-hardening.conf
      mode: 0644
      contents:
        local: services/sshd-hardening.conf

    # Riavvii di Zincati solo nella finestra notturna (default: immediati).
    - path: /etc/zincati/config.d/55-updates-strategy.toml
      mode: 0644
      contents:
        local: services/zincati-updates-strategy.toml

    # --- QUADLET ROOTLESS ---
    # Ognuno nella cartella Quadlet del proprio utente: con il linger,
    # l'istanza systemd dell'utente parte al boot e avvia il container.
    - path: /var/home/homeassistant/.config/containers/systemd/homeassistant.container
      mode: 0644
      user:
        name: homeassistant
      group:
        name: homeassistant
      contents:
        local: services/homeassistant.container

    - path: /var/home/cloudflared/.config/containers/systemd/cloudflared.container
      mode: 0644
      user:
        name: cloudflared
      group:
        name: cloudflared
      contents:
        local: services/cloudflared.container

    # Auto-update notturno di cloudflared (timer utente).
    - path: /var/home/cloudflared/.config/systemd/user/podman-auto-update.timer.d/nightly.conf
      mode: 0644
      user:
        name: cloudflared
      group:
        name: cloudflared
      contents:
        local: services/podman-auto-update-nightly.conf

systemd:
  units:
    - name: zincati.service
      enabled: true
