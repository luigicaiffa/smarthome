# Quadlet ROOTLESS dell'utente di servizio "cloudflared" (uid 1002), senza
# sudo e senza login. Installato in /var/home/cloudflared/.config/containers/systemd/.
# E' il componente rivolto a internet: se venisse compromesso, uscendo dal
# container troverebbe un utente che non puo' fare nulla, non core.

[Unit]
# Non arrendersi mai. Al boot dopo un blackout il server riparte prima di
# modem e router: il DNS risponde SERVFAIL e cloudflared esce subito (non
# riprova da solo se non trova i record SRV di argotunnel.com). Con il limite
# di default systemd, dopo una ventina di riavvii in 40 secondi, smetteva di
# provarci per sempre e il tunnel restava giu' fino a un riavvio manuale
StartLimitIntervalSec=0

[Container]
Image=docker.io/cloudflare/cloudflared:latest
# Aggiornato in automatico ogni notte dal timer utente podman-auto-update
# (vedi podman-auto-update-nightly.conf). Se dopo il riavvio il servizio
# non parte, podman torna da solo all'immagine precedente.
AutoUpdate=registry
# Metriche solo su localhost. Senza --metrics le espone su tutte le interfacce
# e, con Network=host, chiunque in LAN poteva leggere /config: hostname e
# destinazione del tunnel.
Exec=tunnel --metrics 127.0.0.1:20241 run
# Contiene TUNNEL_TOKEN. Sta nella home di cloudflared con permessi 600:
# nessun altro utente di servizio puo' leggerlo.
EnvironmentFile=/var/home/cloudflared/secrets.env
Network=host
NoNewPrivileges=true

[Service]
Restart=always
# Un tentativo ogni 15 secondi invece di uno ogni 2: la rete impiega minuti a
# tornare, non serve martellare e il journal resta leggibile.
RestartSec=15
TimeoutStopSec=70

[Install]
# I servizi rootless usano default.target
WantedBy=default.target