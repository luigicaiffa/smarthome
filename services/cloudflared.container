[Unit]
# Non arrendersi mai. Al boot dopo un blackout il server riparte prima di
# modem e router: il DNS risponde SERVFAIL e cloudflared esce subito (non
# riprova da solo se non trova i record SRV di argotunnel.com). Con il limite
# di default systemd, dopo una ventina di riavvii in 40 secondi, smetteva di
# provarci per sempre e il tunnel restava giu' fino a un riavvio manuale
StartLimitIntervalSec=0

[Container]
Image=docker.io/cloudflare/cloudflared:latest
# Aggiornato in automatico ogni notte dal timer utente podman-auto-update
# (vedi podman-auto-update-nightly.conf). Se dopo il riavvio il servizio
# non parte, podman torna da solo all'immagine precedente.
AutoUpdate=registry
Exec=tunnel run
EnvironmentFile=/var/home/core/homeassistant/secrets.env
Network=host

[Service]
Restart=always
# Un tentativo ogni 15 secondi invece di uno ogni 2: la rete impiega minuti a
# tornare, non serve martellare e il journal resta leggibile.
RestartSec=15
TimeoutStopSec=70

[Install]
# I servizi rootless usano default.target
WantedBy=default.target