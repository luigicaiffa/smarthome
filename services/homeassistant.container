[Unit]
Description=Home Assistant (Rootful System Container)
After=network-online.target bluetooth.service
Wants=bluetooth.service

[Container]
Image=ghcr.io/home-assistant/home-assistant:stable
ContainerName=homeassistant
AutoUpdate=registry

# Disabilita l'isolamento SELinux per comunicare con l'hardware host
SecurityLabelDisable=true

# --- NUOVI PERMESSI BLUETOOTH ATTIVO ---
# Richiesti da HA per inviare comandi (es. lampadine SmartLife/Tuya)
AddCapability=NET_ADMIN
AddCapability=NET_RAW

# Niente EnvironmentFile: secrets.env contiene il TUNNEL_TOKEN di cloudflared,
# e passarlo ad HA lo rendeva leggibile da qualunque integrazione (HACS
# compresa) tramite le variabili d'ambiente. Ad HA serve solo il fuso orario,
# che non e' un segreto.
Environment=TZ=Europe/Rome
Network=host

# Volumi
Volume=/var/home/core/homeassistant/config:/config:Z
Volume=/run/dbus:/run/dbus:ro
Volume=/etc/machine-id:/etc/machine-id:ro

# Tempo concesso ad HA per chiudersi da solo (recorder, integrazioni) prima del
# SIGKILL. Il default di podman e' 10s, troppo poco: HA veniva sempre ucciso a
# meta' spegnimento, sia ai riavvii sia ai reboot di Zincati.
StopTimeout=60

[Service]
# Al boot dopo un blackout il server riparte prima del router:
# network-online.target arriva quando il cavo non ha ancora un indirizzo e HA
# partirebbe senza IPv4. Zeroconf, ssdp, cloud, cast e notify falliscono il
# setup con "Errno 19 No such device" e non riprovano piu': HA resta a meta'
# fino a un riavvio manuale (successo il 7/11, il lease e' arrivato 84 secondi
# dopo l'avvio di HA).
# Si aspetta la default route, cioe' il lease DHCP, e non internet: le
# integrazioni cloud riprovano da sole quando torna il modem. Dopo 5 minuti si
# parte comunque, meglio HA a meta' che HA spento. In condizioni normali il
# lease c'e' gia' e il ciclo esce al primo giro.
# "$$" e' l'escape di systemd per passare un "$" letterale alla shell.
ExecStartPre=/bin/sh -c 'for i in $$(seq 1 150); do ip -4 route show default | grep -q . && exit 0; sleep 2; done; echo "Rete non pronta dopo 5 minuti, avvio Home Assistant comunque"'
# L'attesa qui sopra conta nel timeout di avvio, che di default e' 90 secondi.
TimeoutStartSec=600
# Deve superare StopTimeout, altrimenti systemd uccide il container per primo.
TimeoutStopSec=90

[Install]
# I servizi di sistema usano multi-user.target (non default.target)
WantedBy=multi-user.target