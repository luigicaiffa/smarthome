# Quadlet ROOTLESS dell'utente di servizio "homeassistant" (uid 1001).
# Installato in /var/home/homeassistant/.config/containers/systemd/.
#
# PERCHE' ROOTLESS E CON UN UTENTE SUO
# Fino a novembre 2026 HA girava come root con SELinux disattivato
# (SecurityLabelDisable) e le capability NET_ADMIN/NET_RAW, tutto per il
# Bluetooth, che non era usato. Il processo aveva l'etichetta spc_t: un'integrazione
# compromessa era di fatto root sull'host.
# Ora gira:
#  - rootless: root nel container e' l'utente homeassistant sull'host;
#  - con un utente dedicato, senza sudo e senza login: chi uscisse dal
#    container non trova i privilegi di core (che ha sudo senza password);
#  - confinato da SELinux con l'etichetta standard container_t;
#  - senza capability aggiuntive e senza D-Bus di sistema.
# Se un giorno servisse il Bluetooth, la strada e' un proxy Bluetooth ESPHome
# in rete, non riaprire questi permessi.

[Unit]
Description=Home Assistant (rootless, utente homeassistant)

[Container]
Image=ghcr.io/home-assistant/home-assistant:stable
ContainerName=homeassistant
# Niente AutoUpdate: HA si aggiorna solo a mano con scripts/update_ha.sh.

# Ad HA serve solo il fuso orario, che non e' un segreto. Nessun
# EnvironmentFile: il token del tunnel sta nella home di cloudflared, che
# questo utente non puo' leggere.
Environment=TZ=Europe/Rome

# Rete dell'host: serve alla scoperta di Chromecast, TV e Shelly (mDNS, SSDP).
# Le porte sotto la 1024 sono permesse ai rootless da 80 in su
# (net.ipv4.ip_unprivileged_port_start). Senza NET_RAW HA non puo' leggere il
# traffico altrui: perde solo la scoperta via DHCP, che non serve.
Network=host

# Nessun processo nel container puo' acquisire privilegi nuovi (setuid ecc.).
NoNewPrivileges=true

# :Z rietichetta la cartella per questo solo container a ogni avvio.
Volume=/var/home/homeassistant/config:/config:Z

# Tempo concesso ad HA per chiudersi da solo (recorder, integrazioni) prima del
# SIGKILL. Il default di podman e' 10s, troppo poco: HA veniva sempre ucciso a
# meta' spegnimento, sia ai riavvii sia ai reboot di Zincati.
StopTimeout=60

[Service]
# Al boot dopo un blackout il server riparte prima del router: HA partirebbe
# senza IPv4. Zeroconf, ssdp, cloud, cast e notify falliscono il setup con
# "Errno 19 No such device" e non riprovano piu': HA resta a meta' fino a un
# riavvio manuale (successo il 7/11, il lease e' arrivato 84 secondi dopo
# l'avvio di HA). Un servizio utente non puo' nemmeno aspettare
# network-online.target, che e' del gestore di sistema.
# Si aspetta la default route, cioe' il lease DHCP, e non internet: le
# integrazioni cloud riprovano da sole quando torna il modem. Dopo 5 minuti si
# parte comunque, meglio HA a meta' che HA spento. In condizioni normali il
# lease c'e' gia' e il ciclo esce al primo giro.
# "$$" e' l'escape di systemd per passare un "$" letterale alla shell.
ExecStartPre=/bin/sh -c 'for i in $$(seq 1 150); do ip -4 route show default | grep -q . && exit 0; sleep 2; done; echo "Rete non pronta dopo 5 minuti, avvio Home Assistant comunque"'
# L'attesa qui sopra conta nel timeout di avvio, che di default e' 90 secondi.
TimeoutStartSec=600
# Deve superare StopTimeout, altrimenti systemd uccide il container per primo.
TimeoutStopSec=90
Restart=on-failure
RestartSec=30

[Install]
# I servizi utente usano default.target; il linger li fa partire al boot.
WantedBy=default.target
